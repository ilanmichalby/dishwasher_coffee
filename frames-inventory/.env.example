# Airtable personal access token (scopes: data.records:read, data.records:write; limited to this base)
AIRTABLE_TOKEN=
# From the table URL: airtable.com/appXXXX/tblYYYY/...
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
# Field names exactly as they appear in Airtable
NAME_FIELD=שם
QTY_FIELD=כמות
# Optional: a code required to open the form
ACCESS_CODE=
