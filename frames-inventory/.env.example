# Airtable personal access token (scopes: data.records:read, data.records:write, schema.bases:read; limited to this base)
AIRTABLE_TOKEN=
# From the table URL: airtable.com/appXXXX/tblYYYY/...
AIRTABLE_BASE_ID=appqlA0tGBidsdXSB
AIRTABLE_TABLE_ID=tblw4coZyDOsoKEgo
# Field names exactly as they appear in Airtable
# Optional: column used as the row label (defaults to the table's primary field)
NAME_FIELD=
# Comma-separated number columns to edit
QTY_FIELDS=מלאי,להזמין
# Optional: a code required to open the form
ACCESS_CODE=
